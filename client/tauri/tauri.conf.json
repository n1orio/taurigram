{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Taurigram",
  "mainBinaryName": "taurigram",
  "identifier": "org.taurigram.desktop",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeBuildCommand": "npm run app:build:tauri",
    "frontendDist": "./web/stub",
    "removeUnusedCommands": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tg"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "SocialNetworking",
    "copyright": "Copyright © 2026 Taurigram contributors",
    "shortDescription": "Taurigram — Telegram client",
    "longDescription": "Customizable Telegram desktop client built with Tauri, based on Ethernet and Telegram Web A.",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "dist/",
      "../assets-bundle/": "assets-bundle/"
    },
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "desktopTemplate": null
      }
    },
    "targets": [
      "app",
      "nsis",
      "deb",
      "appimage"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
